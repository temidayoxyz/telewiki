# Get a token from @BotFather on Telegram, then copy this file to `.env`.
BOT_TOKEN=telegram

# Wikipedia language edition (en, de, fr, ...)
WIKI_LANG=en

# SQLite database file (created automatically)
DB_FILE=telewiki.db

# Default daily digest time, HH:MM in UTC
DIGEST_TIME=08:00

# Required by Wikimedia's User-Agent policy: datacenter IPs get HTTP 403
# without contact info. Replace with YOUR contact details.
USER_AGENT=TeleWiki/0.1 (Telegram bot; contact: you@example.com)
