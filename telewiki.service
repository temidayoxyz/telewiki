[Unit]
Description=TeleWiki Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telewiki
WorkingDirectory=/opt/telewiki
ExecStart=/opt/telewiki/.venv/bin/python /opt/telewiki/main.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
